# Kopiere diese Datei nach .env und passe die Werte an.
# PostgreSQL-Verbindung (Prod & Dev). Beispiel lokal via Docker:
#   docker run -d --name taxios-pg -e POSTGRES_PASSWORD=taxios -e POSTGRES_DB=taxios -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:taxios@127.0.0.1:5432/taxios?schema=public"
# AUTH_SECRET: in PRODUKTION zwingend auf einen langen Zufallswert setzen
# (sonst startet die Auth nicht). z.B. `openssl rand -hex 32`.
AUTH_SECRET="bitte-aendern"
PORT=3000
# CORS (Socket.IO) in Produktion auf die echte(n) Domain(s) einschränken, z.B.
# ALLOWED_ORIGINS="https://app.taxios.de,https://taxios.de"
ALLOWED_ORIGINS=
DEFAULT_LAT=52.375892
DEFAULT_LNG=9.732010
# Geocoding/Routing-Anbieter (kommerziell nutzbar). Ohne Key -> freie OSM-Dienste
# (Photon/Nominatim/OSRM) – deren ToS untersagen kommerzielle Last, daher NUR Dev/Test!
# EINE Option setzen; Auto-Auswahl: Mapbox > LocationIQ > frei.
MAPBOX_TOKEN=
LOCATIONIQ_KEY=
LOCATIONIQ_REGION=eu1
# GEO_PROVIDER=mapbox   # optional erzwingen: mapbox | locationiq | free
# Kartenkacheln (Leaflet-Renderer bleibt). Ohne Angabe -> CARTO (nur Dev/Test).
# LocationIQ-Beispiel (Key clientseitig sichtbar -> im LocationIQ-Dashboard auf die
# Domain beschränken!). Muss VOR `next build` gesetzt sein (NEXT_PUBLIC_*).
# NEXT_PUBLIC_MAP_TILES_URL="https://tiles.locationiq.com/v3/streets/r/{z}/{x}/{y}.png?key=pk...."
# NEXT_PUBLIC_MAP_TILES_ATTRIB="&copy; OpenStreetMap, &copy; LocationIQ"
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIB=
ENABLE_SIMULATOR=1
TARIFF_BASE=3.90
TARIFF_PER_KM=2.20
TARIFF_PER_MIN=0.40

# Stripe Authorize-then-Capture. Ohne STRIPE_SECRET_KEY -> Mock (kein echter
# Hold/Charge). Echte Kartenzahlung braucht ALLE drei Werte:
#  - STRIPE_SECRET_KEY (sk_test_… / sk_live_…)          [Server]
#  - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (pk_test_… / pk_live_…) [Client/Elements]
#  - STRIPE_WEBHOOK_SECRET (whsec_…) für /api/payments/webhook
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Gast-Verifizierung (Phase 3h). Telefon-Pflicht vor Dispatch: "0" deaktiviert.
REQUIRE_PHONE_VERIFICATION=1
# Twilio (SMS). Mock-Modus, solange Account-SID + Auth (Key/Token) + Absender nicht gesetzt sind.
# Auth: ENTWEDER API-Key (SK…/Secret, empfohlen) ODER Auth-Token.
# Absender: TWILIO_FROM = Nummer in E.164 ODER alphanumerische Sender-ID (z.B. "Taxi SOS"),
#           ODER TWILIO_MESSAGING_SERVICE_SID (MG…).
# WICHTIG: Alphanumerische Sender-ID ("Taxi SOS") funktioniert NUR mit upgegradetem
#          (bezahltem) Account – im Trial -> Fehler 21267.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM="Taxi SOS"
TWILIO_MESSAGING_SERVICE_SID=
# Resend (E-Mail-Bestaetigung). Ohne Key -> Mock-Modus.
RESEND_API_KEY=
RESEND_FROM="TaxiOS <onboarding@resend.dev>"

# Plattform-Hotline (Phase 3j) – wird im Tracking angezeigt, wenn kein Fahrer frei ist.
NEXT_PUBLIC_PLATFORM_PHONE="+49 511 1234567"

# Provisions-Rechnung (Phase 4): Aussteller-Angaben + USt-Satz auf die Vermittlungsgebühr.
VAT_RATE=0.19
PLATFORM_NAME="TaxiOS Plattform GmbH"
PLATFORM_ADDRESS="Bahnhofstraße 1, 30159 Hannover"
PLATFORM_VAT_ID="DE000000000"
PLATFORM_EMAIL="abrechnung@taxios.app"
