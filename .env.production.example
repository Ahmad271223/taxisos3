# =============================================================================
# Vorlage für den ECHTBETRIEB
# =============================================================================
# Diese Datei nach .env.production kopieren und ausfüllen. Der Server prüft die
# Werte beim Start selbst (src/server/liveGuard.ts) und verweigert den Start,
# wenn eine Einstellung den Echtbetrieb gefährden würde.
#
# Prüfen ohne echten Start:
#   NODE_ENV=production npx tsx scripts/qa/_guard_probe.ts
#
# X = Start wird verweigert, solange das nicht stimmt
# ! = Start läuft, aber mit Einschränkung
# =============================================================================

NODE_ENV=production
PORT=3000

# --- Datenbank ---------------------------------------------------------------
# Eigener PostgreSQL-Server mit Backup. NICHT der Docker-Container aus dem Test.
DATABASE_URL=postgresql://BENUTZER:PASSWORT@HOST:5432/taxios

# --- Adresse der Anwendung ---------------------------------------------------
# X Muss die echte HTTPS-Domain sein: Stripe springt nach der Karteneingabe
#   hierher zurück, und alle Links in SMS zeigen hierauf.
APP_BASE_URL=https://ihre-domain.de
# ! Ohne Eintrag nimmt die Live-Verbindung Anfragen von jeder Website an.
ALLOWED_ORIGINS=https://ihre-domain.de

# --- Sicherheit --------------------------------------------------------------
# X Mindestens 32 Zeichen Zufall. Neu erzeugen mit: openssl rand -hex 32
#   Beim Wechsel werden alle Anmeldungen ungültig.
AUTH_SECRET=HIER_64_ZEICHEN_ZUFALL_EINSETZEN

# --- Zahlung (Stripe) --------------------------------------------------------
# X Live-Schlüssel aus dem Stripe-Dashboard (Testmodus ausschalten).
#   Solange hier sk_test_ steht, fließt KEIN echtes Geld.
STRIPE_SECRET_KEY=sk_live_...
# ! Webhook im Stripe-Dashboard auf https://ihre-domain.de/api/stripe/webhook
#   anlegen. Ohne das kommen Abo- und Auszahlungsstatus nur verzögert an.
STRIPE_WEBHOOK_SECRET=whsec_...
# Wird nicht benötigt: die Karteneingabe läuft auf der Seite von Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Deckungsprüfung beim Fahrtstart: Aufschlag auf die Preisschätzung in Prozent
# und Mindestbetrag in Euro. Höher = mehr Sicherheit, aber der Betrag ist beim
# Kunden kurzzeitig vorgemerkt. Abgebucht wird immer nur der echte Fahrpreis.
HOLD_BUFFER_PCT=30
HOLD_MIN_EUR=15

# --- SMS (Twilio) ------------------------------------------------------------
# X Ohne diese Angaben erfährt kein Kunde etwas über seine Fahrt.
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
# ! Deutsche Absendernummer verwenden. Eine US-Nummer wird von deutschen
#   Netzen häufiger blockiert oder als Spam einsortiert.
#   Wichtig: das Twilio-Testkonto muss auf ein bezahltes Konto umgestellt sein,
#   sonst gehen SMS nur an vorher verifizierte Nummern und tragen einen
#   Testhinweis im Text.
TWILIO_FROM=+49...
# X Der Notaus darf im Echtbetrieb nicht gesetzt sein.
SMS_DISABLED=

# --- Betrieb -----------------------------------------------------------------
# X Fahrten-Simulator: erfindet Fahrer und Positionen. Im Echtbetrieb aus.
ENABLE_SIMULATOR=0
# ! Auf 1 setzen, damit Buchungen nur mit bestätigter Telefonnummer möglich sind.
REQUIRE_PHONE_VERIFICATION=1
# Abbruch der Fahrersuche nach 3 Minuten, danach Hinweis auf die Zentrale.
SEARCH_MAX_MS=180000
# Nummer der Taxizentrale, die Kunden bei erfolgloser Suche angezeigt bekommen.
NEXT_PUBLIC_PLATFORM_PHONE="0160 92750000"
# Zeitfenster für die Trinkgeldauswahl nach Fahrtende (Millisekunden).
TIP_WINDOW_MS=120000

# --- Karten und Routen -------------------------------------------------------
# ! Ohne Schlüssel laufen Adresssuche und Routenberechnung über die kostenlosen
#   OpenStreetMap-Dienste. Deren Nutzungsbedingungen erlauben KEINE gewerbliche
#   Nutzung, und bei Last wird gedrosselt. Für den Echtbetrieb einen Anbieter
#   buchen (Mapbox, LocationIQ oder Google).
MAPBOX_TOKEN=
LOCATIONIQ_KEY=
# Kartenkacheln: ohne eigenen Anbieter wird der Demo-Dienst von CARTO genutzt.
NEXT_PUBLIC_MAP_TILES_URL=

# --- Flugdaten ---------------------------------------------------------------
# ! Ohne Schlüssel liefern Flugnummern Demo-Daten statt echter Ankunftszeiten.
AVIATIONSTACK_KEY=

# --- Push an Fahrer ----------------------------------------------------------
# ! Ohne Schlüssel verpassen Fahrer Aufträge bei gesperrtem Bildschirm.
#   Erzeugen mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:kontakt@ihre-domain.de"

# --- E-Mail (optional) -------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="TaxiOS <noreply@ihre-domain.de>"

# --- Notausgang --------------------------------------------------------------
# Nur für eine bewusste Generalprobe mit Testdaten. Umgeht die Startsperre.
# NIEMALS mit echten Kunden setzen.
ALLOW_TEST_MODE_IN_PRODUCTION=
