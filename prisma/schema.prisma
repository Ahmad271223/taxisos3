// TaxiConnect / TaxiOS Datenmodell (Multi-Mandant)
// Provider auf "postgresql" umstellen + DATABASE_URL anpassen, um produktiv zu gehen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Taxiunternehmen (Mandant + Admin-Account)
// ---------------------------------------------------------------------------
model Company {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // fuer den Kunden-Buchungslink /c/<slug>
  address      String?
  phone        String?
  email        String   @unique // Admin-Login
  passwordHash String

  // Provisionsstufe: BIG (Großstadt, 7%) | SMALL (Klein/ländlich, 5%)
  cityTier     String   @default("SMALL")

  drivers      Driver[]
  bookings     Booking[]
  pricing      Pricing?
  classPricing VehicleClassPricing[]
  fixedPrices  FixedPriceRule[]
  invoices     Invoice[]

  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Festpreis-Manager (Pricing-Engine): jedes Unternehmen kann für bestimmte
// Strecken/Zonen einen festen Preis hinterlegen (z. B. "Zentrum → Flughafen
// = 45 €"). Eine Zone ist Mittelpunkt + Radius. Greift eine Regel, wird der
// feste Preis statt des Meter-Tarifs verwendet – sowohl in der Live-Spanne als
// auch beim Einfrieren des Festpreises (priceExact) nach Fahrerannahme.
// ---------------------------------------------------------------------------
model FixedPriceRule {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name          String
  fromLabel     String?
  fromLat       Float
  fromLng       Float
  fromRadius    Int     @default(1500) // Meter
  toLabel       String?
  toLat         Float
  toLng         Float
  toRadius      Int     @default(1500) // Meter
  price         Float                  // fester Endpreis (EUR)
  bidirectional Boolean @default(true) // gilt auch in Gegenrichtung
  vehicleClass  String?                // nur für eine Klasse (null = alle)
  active        Boolean @default(true)

  createdAt     DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Preis je Fahrzeugklasse pro Unternehmen (Phase 12 Marktplatz).
// Fehlt ein Eintrag, gilt der Plattform-Standardfaktor aus lib/vehicleClasses.
// ---------------------------------------------------------------------------
model VehicleClassPricing {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  classKey      String  // STANDARD | VAN | ... (siehe lib/vehicleClasses)
  enabled       Boolean @default(true)
  multiplier    Float   @default(1.0) // Faktor auf den Firmen-Grundtarif
  flatSurcharge Float   @default(0)   // optionaler Fixaufschlag (EUR)

  updatedAt     DateTime @updatedAt

  @@unique([companyId, classKey])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Preis-Einstellungen je Unternehmen
// ---------------------------------------------------------------------------
model Pricing {
  id             String   @id @default(cuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  basePrice      Float    @default(4.0) // Grundpreis
  perKmDay       Float    @default(2.5) // Tagtarif 06:00-22:00
  perKmNight     Float    @default(3.2) // Nachttarif 22:00-06:00
  perKmWeekend   Float    @default(2.8) // Wochenende (Sa/So)
  perMinute      Float    @default(0.0) // optionaler Zeitanteil
  nightStartHour Int      @default(22)
  nightEndHour   Int      @default(6)

  // Festpreis-Engine (dynamisch): ohne manuelle Festpreis-Regel wird der
  // Meter-Schätzpreis + Risiko-Buffer (%) als garantierter Festpreis gefroren.
  // 0 = aus (klassischer Meter-Tarif).
  fixedBufferPct Float    @default(0)
  // Aufschlag je Zwischenstopp (EUR), zusätzlich zur Streckenberechnung.
  perStopFee     Float    @default(0)
  // No-Show-Gebühr (EUR): berechnet, wenn der Gast nach Ankunft nicht erscheint. 0 = keine.
  noShowFee      Float    @default(0)

  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Plattform-Leitplanken (Super-Admin, Singleton id="default"):
//  - Preisuntergrenzen gegen ruinöses Unterbieten der Firmen
//  - Krankenkassen-Tarif (DTA): fester Cent-pro-km-Satz für Kassenfahrten
// Alle Werte 0 = aus.
// ---------------------------------------------------------------------------
model PlatformConfig {
  id                String   @id @default("default")
  // Preisuntergrenze: Endpreis >= minBaseFare + minPerKm * km.
  minBaseFare       Float    @default(0)
  minPerKm          Float    @default(0)
  // Krankenkassen-/DTA-Tarif für payerType = INSURANCE.
  insuranceBaseFare Float    @default(0)
  insurancePerKm    Float    @default(0)

  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Fahrer (inkl. Fahrzeugdaten)
// ---------------------------------------------------------------------------
model Driver {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  username     String   @unique
  passwordHash String
  name         String
  phone        String?

  // Status: FREI | BESETZT | PAUSE | OFFLINE
  status       String   @default("OFFLINE")

  // Letzte bekannte GPS-Position
  lat          Float?
  lng          Float?
  speed        Float?
  lastSeenAt   DateTime?

  // Fahrzeug
  vehicleModel String?
  vehiclePlate String?
  vehicleColor String?
  vehicleSeats Int      @default(4)
  // Fahrzeugklasse fuer den Marktplatz (Phase 12): STANDARD | VAN | EXTRA_LUGGAGE
  // | SHUTTLE | BUSINESS | WHEELCHAIR | PET | CHILD_SEAT | VIP. Siehe lib/vehicleClasses.
  vehicleClass String   @default("STANDARD")
  // Freigabe fuer Krankenfahrten (Phase 15): nur freigegebene Fahrer erhalten
  // Buchungen mit medicalType. Siehe server/dispatch.ts Kandidatenfilter.
  medicalAllowed Boolean @default(false)
  // Fahrzeug-Ausstattung fuer Krankenfahrten (Phase D): Rollstuhlrampe/Lift
  // bzw. Tragestuhl. Gating zusaetzlich zur Fahrzeugklasse im Dispatcher.
  hasRamp        Boolean @default(false)
  hasStretcher   Boolean @default(false)
  // Fahrerqualifikationen (Phase: Fahrerprofil). pScheinUntil leer = nicht hinterlegt.
  pScheinUntil      String?  // Personenbeförderungsschein gültig bis (ISO "YYYY-MM-DD")
  wheelchairTrained Boolean @default(false) // Rollstuhlhilfe geschult
  qualifications    String?  // Sonderqualifikationen (Freitext)

  // Fahrer-/Fahrzeug-Dokumente mit Ablaufdatum (ISO "YYYY-MM-DD"). Leer = nicht
  // hinterlegt. Für Compliance-Prüfung + Ablaufwarnung (siehe lib/driverDocs).
  licenseUntil      String?  // Führerschein gültig bis
  concessionUntil   String?  // Taxikonzession gültig bis
  insuranceUntil    String?  // Kfz-Versicherung gültig bis
  tuevUntil         String?  // TÜV/HU gültig bis

  active       Boolean  @default(true)

  bookings     Booking[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Auftrag / Buchung
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Gruppen-/Eventbuchung (Phase 13): eine Bestellung über mehrere Fahrzeuge
// (Hochzeit, Firma, Messe-Shuttle ...). Jedes Fahrzeug ist eine eigene Booking
// mit groupId; der Versand/Tracking/Preis läuft je Fahrzeug wie gewohnt.
// ---------------------------------------------------------------------------
model BookingGroup {
  id              String   @id @default(cuid())

  customerName    String
  customerPhone   String
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  destAddress     String
  destLat         Float
  destLng         Float

  isScheduled     Boolean  @default(false)
  scheduledAt     DateTime?

  vehicleCount    Int
  totalPassengers Int      @default(1)
  totalLuggage    Int      @default(0)
  eventLabel      String?
  notes           String?
  paymentMethod   String   @default("CASH")

  bookings        Booking[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
}

model Booking {
  id             String   @id @default(cuid())
  // Hochentropischer Tracking-Token (UUID v4) für Gast-Links /verfolgen/<token>.
  // Entkoppelt die Capability vom (teils geloggten/sichtbaren) Datensatz-Schlüssel.
  trackingToken  String?  @unique @default(uuid())
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Teil einer Gruppen-/Eventbuchung (Phase 13)?
  groupId        String?
  group          BookingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Krankenfahrt (Phase 15): Kategorie + ggf. Teil einer wiederkehrenden Serie.
  medicalType    String?  // DIALYSE | REHA | KRANKENHAUS | ARZT | SONSTIGE
  recurringId    String?
  recurring      RecurringRide? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  // Krankenfahrt-Details (Phase B): Patient (falls abweichend vom Besteller),
  // Mobilität, Begleitpersonen, mitzuführende Ausstattung, Kostenträger.
  patientName      String?
  patientBirthDate String?  // ISO "YYYY-MM-DD"
  mobility         String?  // WALK | CANE | WALKER | WHEELCHAIR | E_WHEELCHAIR
  companions       Int      @default(0)
  medicalEquipment String?  // CSV: OXYGEN,WALKER,WHEELCHAIR,LUGGAGE,CANE
  payerType        String?  // SELF | INSURANCE
  insuranceName    String?
  insuranceNumber  String?
  returnAt         DateTime? // optionale automatische Rückfahrt (Einzelfahrt)

  // Fahrzeug-Anforderungen (Phase D): zusätzlich zur Klasse erzwungene Ausstattung.
  requiresRamp      Boolean @default(false)
  requiresStretcher Boolean @default(false)

  // Buchung durch eine Einrichtung (Phase E: Klinik/Pflegeheim/Dialyse).
  institutionId  String?
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Verknüpfung zum Stammpatienten der Einrichtung (für die Fahrtenhistorie).
  institutionPatientId String?
  institutionPatient   InstitutionPatient? @relation(fields: [institutionPatientId], references: [id], onDelete: SetNull)

  // Hotel-Buchung (B2B Mobility): Gast-Fahrt durch ein Hotel.
  hotelId        String?
  hotel          Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  roomNumber     String?
  hotelPayment   String?   // DIRECT | ROOM | CORPORATE
  // Hotel-Flotten-Whitelist (CSV bevorzugter Firmen-IDs) + VIP-Layer.
  preferredCompanyIds String @default("")
  isVip          Boolean @default(false)

  // Event-Promo-Code (Mass Mobility): eingelöster Code + gewährter Rabatt (EUR).
  promoCode      String?
  promoDiscount  Float?

  // Hochgeladene Nachweise (Phase C): Verordnung/Genehmigung etc.
  documents      MedicalDocument[]

  // Digitaler Fahrtnachweis (Unterschrift des Fahrgasts).
  signature      RideSignature?

  // Kundendaten
  customerName   String
  customerPhone  String
  // Optionales Kundenkonto (Gastbuchungen bleiben ohne)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Adressen + Koordinaten
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  destAddress    String
  destLat        Float
  destLng        Float

  // Mehrziel-Vorabplanung (Phase 2e): Zwischenstopps zwischen Abholung und Ziel,
  // als JSON-Array [{address,lat,lng}] in Anfahrt-Reihenfolge. Leer = Direktfahrt.
  stops          String?

  // Optionen
  passengers     Int      @default(1)
  luggage        Boolean  @default(false)
  childSeat      Boolean  @default(false)
  notes          String?

  // Gewünschte Fahrzeugklasse (Phase 12 Marktplatz). Bestimmt Preis-Faktor und
  // welche Fahrer ein Angebot erhalten. Siehe lib/vehicleClasses.
  vehicleClass   String   @default("STANDARD")

  // Vorbestellung
  isScheduled    Boolean  @default(false)
  scheduledAt    DateTime?

  // Flughafen-Modul (Phase 14): an einen Flug gekoppelte Fahrt mit
  // Verspätungserkennung. flightScheduledAt = geplante Flugzeit (Landung/Abflug);
  // die Abholzeit (scheduledAt) wird daraus + Verspätung + Puffer berechnet.
  flightNumber      String?
  flightDirection   String?   // ARRIVAL | DEPARTURE
  terminal          String?
  flightStatus      String?
  flightScheduledAt DateTime?
  flightDelayMinutes Int      @default(0)

  // Airport-Extras: Meet & Greet Service-Stufe + Wartezeit-Fairpreis.
  meetGreet      String?   // BASIC | TERMINAL | PREMIUM
  meetGreetFee   Float?    // Aufschlag für den Service (EUR)
  waitMinutes    Int?      // abgerechnete Wartezeit (über dem Freikontingent)
  waitFee        Float?    // Wartezeit-Gebühr (EUR)

  // Schaetzung / Preis
  distanceMeters Int?
  durationSeconds Int?
  priceMin       Float?
  priceMax       Float?
  // Vorab-„ca."-Preis aus dem täglichen Plattform-Durchschnitt (vor Fahrer-Annahme)
  priceApprox    Float?
  tariff         String?  // TAG | NACHT | WOCHENENDE
  fare           Float?
  // Exakter Festpreis nach Fahrer-Annahme (Pflicht fuer Endpreis)
  priceExact     Float?
  // Autorisierter Kartenbetrag (Stripe Hold, Phase 2g) – obere Schaetzung,
  // tatsaechliche Belastung (capture) erfolgt nach Fahrtende mit `fare`.
  priceAuthorized Float?
  // Plattform-Provision
  platformFeeRate Float?  // 0.07 oder 0.05
  platformFee    Float?   // EUR
  companyNet     Float?   // EUR (= fare - platformFee)

  // Auftragsstatus (Admin):
  //   OFFEN | ZUGEWIESEN | AKTIV | ABGESCHLOSSEN | STORNIERT
  status         String   @default("OFFEN")

  // Kunden-Tracking-Status
  trackingStatus String   @default("SUCHE")

  // Zuweisung
  driver         Driver?  @relation(fields: [driverId], references: [id])
  driverId       String?
  declinedDriverIds String @default("")

  // Bewertung
  rating         Int?
  ratedAt        DateTime?
  ratingComment  String?

  // Zahlung
  paymentMethod  String   @default("CASH") // CASH | CARD | FIRMA
  paymentStatus  String   @default("OFFEN") // OFFEN | AUTORISIERT | BEZAHLT | FEHLGESCHLAGEN | STORNIERT | FIRMA
  paymentRef     String?  // Stripe PaymentIntent o.ae.

  // Festpreis-Engine: wurde der Endpreis aus einer Festpreis-Regel gefroren
  // (true) oder per Meter-Tarif berechnet (false)?
  priceIsFixed   Boolean @default(false)

  // QR-Firmenmobilität: per QR-Code eingelöstes Firmenkonto übernimmt die Fahrt.
  corporateCode  String?  // eingelöster Mobilitäts-Code
  corporatePayer String?  // Name der zahlenden Firma (für Fahrer/Beleg)
  // Aktuell auf das Firmen-Budget gebuchter Betrag (Cent): beim Buchen der
  // geschätzte Preis (Hold), nach Fahrtende der Endpreis, bei Storno 0.
  corporateSettledCents Int?

  assignedAt     DateTime?
  acceptedAt     DateTime?
  arrivedAt      DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?  // ..., NO_SHOW (Gast nicht erschienen)
  cancelledBy    String?  // CUSTOMER | ADMIN | DRIVER | SYSTEM
  noShowFee      Float?   // berechnete No-Show-Gebühr (wenn cancelReason = NO_SHOW)

  // Reservierte Folgefahrt (Bolt-Style "near completion")
  isReserved     Boolean  @default(false)

  // Erinnerungen (24h/2h/30min vor der Fahrt): bereits gesendete Offsets als CSV
  // ("24h,2h,30m"), damit jede Erinnerung genau einmal verschickt wird.
  remindersSent  String   @default("")

  // Notfall-Rettungsfahrt (Phase 21): per SOS automatisch zum Standort disponiert.
  isSos          Boolean  @default(false)

  // Gezielt gewähltes Taxi von der Live-Karte (Phase 23): nur dieser Fahrer wird
  // zuerst angefragt. Bei Ablehnung/Timeout normale Disposition.
  requestedDriverId String?

  // Zieländerung während der Fahrt (Phase 2f)
  destChangedAt   DateTime?
  destChangeCount Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cancellations  CancellationLog[]
  messages       ChatMessage[]

  @@index([companyId])
  @@index([status])
  @@index([driverId])
  @@index([groupId])
  @@index([recurringId])
}

// ---------------------------------------------------------------------------
// Wiederkehrende (Kranken-)Fahrt (Phase 15): Serie aus Wochentagen + Uhrzeit
// (z. B. Dialyse Mo/Mi/Fr). Der Scheduler erzeugt daraus im Voraus geplante
// Buchungen (siehe lib/recurring).
// ---------------------------------------------------------------------------
model RecurringRide {
  id              String   @id @default(cuid())

  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName    String
  customerPhone   String

  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  destAddress     String
  destLat         Float
  destLng         Float

  vehicleClass    String   @default("WHEELCHAIR")
  medicalType     String?

  // Krankenfahrt-Details (Phase B), analog zu Booking.
  patientName      String?
  patientBirthDate String?
  mobility         String?
  companions       Int      @default(0)
  medicalEquipment String?
  payerType        String?
  insuranceName    String?
  insuranceNumber  String?
  requiresRamp      Boolean @default(false)
  requiresStretcher Boolean @default(false)

  // Serie durch eine Einrichtung angelegt (Phase E).
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  documents       MedicalDocument[]

  daysOfWeek      String   // CSV 0–6 (0 = Sonntag)
  timeOfDay       String   // "HH:MM" Hinfahrt
  returnTrip      Boolean  @default(false)
  returnTimeOfDay String?  // "HH:MM" Rückfahrt

  startDate       DateTime
  endDate         DateTime?
  active          Boolean  @default(true)
  notes           String?

  bookings        Booking[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Gast-Verifizierung (Phase 3h): SMS-/E-Mail-Code vor der Buchung
// ---------------------------------------------------------------------------
model Verification {
  id         String   @id @default(cuid())
  channel    String   // SMS | EMAIL
  target     String   // Telefonnummer bzw. E-Mail (normalisiert)
  codeHash   String   // bcrypt-Hash des 6-stelligen Codes
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channel, target])
  @@index([target])
}

// ---------------------------------------------------------------------------
// Kundenkonto (optional – Gäste können weiter ohne Konto buchen)
// ---------------------------------------------------------------------------
model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Bonus-/Punktesystem (Phase 18)
  points       Int      @default(0)

  // Notfallkontakt für SOS (Phase 17)
  emergencyContactName  String?
  emergencyContactPhone String?

  bookings     Booking[]
  groups       BookingGroup[]
  recurring    RecurringRide[]
  favorites    Favorite[]
  sosAlerts    SosAlert[]
  documents    MedicalDocument[]

  @@index([phone])
}

// ---------------------------------------------------------------------------
// Einrichtung (Phase E): Klinik / Pflegeheim / Dialyse- / Reha-Zentrum mit
// eigenem Login. Kann Stammpatienten anlegen und für sie Krankenfahrten und
// Serien buchen sowie Rechnungen/Dokumente verwalten.
// ---------------------------------------------------------------------------
model Institution {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("KLINIK") // KLINIK | PFLEGEHEIM | DIALYSE | REHA
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  active       Boolean  @default(true)

  patients     InstitutionPatient[]
  bookings     Booking[]
  recurring    RecurringRide[]
  documents    MedicalDocument[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Stammpatient einer Einrichtung – Daten müssen nicht je Fahrt neu erfasst werden.
model InstitutionPatient {
  id            String   @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  name          String
  birthDate     String?  // ISO "YYYY-MM-DD"
  gender        String?  // M | F | D
  phone         String?
  email         String?
  address       String?  // Wohnanschrift
  defaultPickupAddress String?
  defaultPickupLat     Float?
  defaultPickupLng     Float?
  mobility      String?
  medicalEquipment String?
  payerType     String?
  insuranceName String?
  insuranceNumber String?
  kostentraegerNummer String?   // IK-Nummer der Krankenkasse
  befreiungUntil String?        // Befreiungsausweis gültig bis (ISO)
  notes         String?

  bookings      Booking[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// Medizinisches Dokument (Phase C): Verordnung, Genehmigung der Krankenkasse,
// Rezept oder Arztbescheinigung. Inhalt als Base64 in der DB; Admin prüft.
// ---------------------------------------------------------------------------
model MedicalDocument {
  id            String   @id @default(cuid())

  kind          String   // VERORDNUNG | GENEHMIGUNG | REZEPT | BESCHEINIGUNG
  fileName      String
  mimeType      String
  dataBase64    String   // Dateiinhalt (Base64); fuer Demo ausreichend
  // Gültigkeit (Phase: Ablauf-Ampel). Leer = unbefristet/ohne Angabe.
  validUntil    String?  // ISO "YYYY-MM-DD"

  // Zuordnung (mind. eine gesetzt)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingId     String?
  booking       Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  recurringId   String?
  recurring     RecurringRide? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  uploadedByType String? // CUSTOMER | INSTITUTION | ADMIN

  // Prüf-Workflow (Dokumentenprüfung / Genehmigungsverwaltung)
  reviewStatus  String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote    String?
  reviewedAt    DateTime?

  createdAt     DateTime @default(now())

  @@index([reviewStatus])
  @@index([bookingId])
  @@index([customerId])
  @@index([institutionId])
}

// ---------------------------------------------------------------------------
// Event-Veranstalter (Mass Mobility): eigenes Konto, das Promo-Codes für
// Events vergibt (z. B. „IAA2026"), subventionierte/gesponserte Fahrten.
// ---------------------------------------------------------------------------
model EventHost {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  active       Boolean  @default(true)

  promos          PromoCode[]
  zones           EventZone[]
  corporateCodes  CorporateCode[]
  events          Event[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Konkrete Veranstaltung (Hochzeit/Messe/Konferenz ...) eines Veranstalters:
// Metadaten + Gästeliste + Shuttle-Zeiten.
model Event {
  id             String   @id @default(cuid())
  eventHostId    String
  eventHost      EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  name           String
  contactName    String?
  contactPhone   String?
  eventDate      String?  // ISO "YYYY-MM-DD"
  location       String?
  expectedGuests Int?
  notes          String?
  active         Boolean  @default(true)

  guests         EventGuest[]
  shuttles       ShuttleSlot[]

  createdAt      DateTime @default(now())

  @@index([eventHostId])
}

model EventGuest {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name         String
  phone        String?
  groupName    String?  // Gruppe/Reisegruppe
  hotel        String?
  destAddress  String?  // Zieladresse
  isVip        Boolean  @default(false)
  requirements String?  // besondere Anforderungen

  createdAt    DateTime @default(now())

  @@index([eventId])
}

model ShuttleSlot {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label        String   // z. B. "Hotel A -> Messe"
  fromAddress  String?
  toAddress    String?
  time         String   // "HH:MM"
  vehicleClass String?  // optional Fahrzeugtyp
  seats        Int?     // Plätze/erwartete Personen

  createdAt    DateTime @default(now())

  @@index([eventId])
}

// QR-Firmenmobilität: ein Mobilitäts-Code, den die Firma als QR ausgibt. Gäste/
// Mitarbeiter scannen ihn und buchen Fahrten, die das Firmenkonto übernimmt –
// gedeckelt über Budget, Anzahl Fahrten und/oder Max-Betrag pro Fahrt.
model CorporateCode {
  id            String   @id @default(cuid())
  eventHostId   String
  eventHost     EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  code          String   @unique // Token im QR-Link, z. B. "FX7K2P9A"
  label         String?            // z. B. "Gäste IAA 2026", "Außendienst"
  budgetCents   Int?               // optionales Gesamtbudget (Cent), null = unbegrenzt
  maxRides      Int?               // optionale max. Anzahl Fahrten
  perRideCents  Int?               // optionaler Max-Betrag pro Fahrt (Cent)
  validUntil    String?            // ISO "YYYY-MM-DD"
  active        Boolean  @default(true)

  usedRides     Int      @default(0)
  usedCents     Int      @default(0) // bereits verbuchte Summe (Cent)

  createdAt     DateTime @default(now())

  @@index([eventHostId])
}

// Geo-Fenced Pickup-Zone (virtueller Taxistand) eines Events: Abholungen im
// Radius werden auf diesen Sammelpunkt gelenkt (verhindert Chaos/Stau).
model EventZone {
  id           String   @id @default(cuid())
  eventHostId  String
  eventHost    EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  name         String
  lat          Float
  lng          Float
  radiusMeters Int      @default(300)
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())

  @@index([eventHostId])
}

model PromoCode {
  id            String   @id @default(cuid())
  eventHostId   String
  eventHost     EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade)

  code          String   @unique // z. B. "IAA2026"
  label         String?
  discountType  String   @default("PERCENT") // PERCENT | FIXED
  discountValue Float    // Prozent (0–100) oder fester EUR-Betrag
  validUntil    String?  // ISO "YYYY-MM-DD"
  maxUses       Int?
  usedCount     Int      @default(0)
  active        Boolean  @default(true)

  createdAt     DateTime @default(now())

  @@index([eventHostId])
}

// ---------------------------------------------------------------------------
// Hotel (B2B Mobility OS): Hotel-Konto mit eigenem Login. Die Rezeption bucht
// Fahrten für Gäste (guestless: SMS-Trackinglink) und rechnet wahlweise per
// Charge-to-Room / Firmenkonto ab.
// ---------------------------------------------------------------------------
model Hotel {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  active       Boolean  @default(true)
  // Smart Fleet Routing: bevorzugte Taxifirmen (CSV company-IDs). Leer = offen.
  preferredCompanyIds String @default("")

  bookings     Booking[]
  guests       HotelGuest[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Stammgäste eines Hotels: für 30-Sekunden-Buchung (Profil + Stammziel + VIP).
model HotelGuest {
  id                    String   @id @default(cuid())
  hotelId               String
  hotel                 Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  name                  String
  phone                 String?
  roomNumber            String?
  language              String?  // bevorzugte Sprache
  preferredVehicleClass String?  // bevorzugtes Fahrzeug (STANDARD | VAN | VIP ...)
  defaultDestAddress    String?  // Stammziel (z. B. Flughafen)
  defaultDestLat        Float?
  defaultDestLng        Float?
  isVip                 Boolean  @default(false)
  notes                 String?  // besondere Hinweise

  createdAt             DateTime @default(now())

  @@index([hotelId])
}

// Beschwerden/Support-Tickets: B2B-Partner (Hotel/Event/Einrichtung) melden
// Probleme; der Plattform-Betreiber (Super-Admin) bearbeitet sie.
model SupportTicket {
  id           String   @id @default(cuid())
  reporterType String   // HOTEL | EVENT | INSTITUTION
  reporterId   String
  reporterName String
  category     String   // DRIVER_NO_SHOW | GUEST_NOT_FOUND | WRONG_VEHICLE | WRONG_INVOICE | BAD_BEHAVIOR | OTHER
  subject      String
  message      String
  bookingId    String?
  status       String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  adminNote    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([reporterType, reporterId])
  @@index([status])
}

// Sub-Nutzer eines B2B-Portals (Hotel/Event) mit eigener Rolle/Rechten. Die
// Login-Session behält sub = Parent-ID (alle bestehenden APIs bleiben unverändert
// gescoped); zusätzlich trägt sie die portalRole für das Rechte-Gating.
model PortalUser {
  id           String   @id @default(cuid())
  parentType   String   // HOTEL | EVENT
  parentId     String
  name         String
  email        String   @unique
  passwordHash String
  role         String   // ADMIN | RECEPTION | ACCOUNTING | CONCIERGE | NIGHT | MANAGER
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())

  @@index([parentType, parentId])
}

// ---------------------------------------------------------------------------
// Digitaler Fahrtnachweis: Unterschrift des Fahrgasts (PNG) + Zeitstempel + GPS,
// fest an die Fahrt gekoppelt. Dient als Nachweis (z. B. für Krankenkassen).
// ---------------------------------------------------------------------------
model RideSignature {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  signedName String?
  dataBase64 String   // Unterschrift als PNG (Base64-Data-URL-Inhalt)
  lat        Float?
  lng        Float?
  signedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Zugriffsprotokoll (Phase F / DSGVO): protokolliert Zugriffe auf
// Gesundheits-/Patientendaten (wer, was, wann).
// ---------------------------------------------------------------------------
model AccessLog {
  id        String   @id @default(cuid())
  actorType String   // ADMIN | INSTITUTION | CUSTOMER | SYSTEM
  actorId   String?
  action    String   // VIEW | DOWNLOAD | APPROVE | REJECT | CREATE | EXPORT
  entity    String   // MEDICAL_DOCUMENT | BOOKING | PATIENT | RECURRING
  entityId  String?
  detail    String?
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorType, actorId])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Lieblingsfahrer/-unternehmen (Phase 18). Genau eines von driverId/companyId.
// ---------------------------------------------------------------------------
model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driverId   String?
  companyId  String?
  createdAt  DateTime @default(now())

  @@unique([customerId, driverId])
  @@unique([customerId, companyId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// SOS-/Notfallmeldung (Phase 17): vom Kunden während/zur Fahrt ausgelöst.
// ---------------------------------------------------------------------------
model SosAlert {
  id            String   @id @default(cuid())
  bookingId     String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  lat           Float?
  lng           Float?
  message       String?
  status        String   @default("OPEN") // OPEN | RESOLVED
  companyId     String?  // betroffenes Unternehmen (für Admin-Routing)
  rescueBookingId String? // automatisch erzeugte Notfall-Rettungsfahrt (Phase 21)
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?

  @@index([status])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Plattform-Durchschnittstarif (täglich 02:00 berechnet) – Basis für den
// „ca."-Vorabpreis, bevor ein Fahrer (und damit der Firmentarif) feststeht.
// ---------------------------------------------------------------------------
model PlatformRate {
  id           String   @id @default("current")
  avgBasePrice Float
  avgPerKm     Float
  avgPerMinute Float    @default(0)
  companyCount Int      @default(0)
  computedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Rechnungs-Archiv (Phase 6): festgeschriebene Monats-Provisionsrechnung mit
// Lebenszyklus (offen/bezahlt/storniert), Mahnungen und Zahlungsabgleich.
// Beträge + Positionen sind ein eingefrorener Snapshot (unveränderlich).
// ---------------------------------------------------------------------------
model Invoice {
  id            String   @id @default(cuid())
  invoiceNo     String   @unique
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  monthKey      String   // "YYYY-MM"
  periodLabel   String

  // Eingefrorener Snapshot zum Ausstellungszeitpunkt
  trips         Int
  grossRevenue  Float
  net           Float
  vatRate       Float
  vat           Float
  gross         Float
  linesJson     String   // JSON: InvoiceLine[]
  issuerJson    String   // JSON: { name, address, vatId, email }
  recipientJson String   // JSON: { name, slug, address, email, cityTier, ratePct }

  // Lebenszyklus
  status        String   @default("OFFEN") // OFFEN | BEZAHLT | STORNIERT
  issuedAt      DateTime @default(now())
  dueAt         DateTime
  paidAt        DateTime?
  paymentRef    String?  // Zahlungsreferenz / Notiz (Zahlungsabgleich)

  // Mahnwesen
  remindersSent  Int      @default(0)
  lastReminderAt DateTime?
  emailSentAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, monthKey])
  @@index([companyId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Live-Chat Kunde <-> Fahrer (Phase 3i)
// ---------------------------------------------------------------------------
model ChatMessage {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    String   // CUSTOMER | DRIVER
  text      String
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Stornierungs-Protokoll
// ---------------------------------------------------------------------------
model CancellationLog {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorType  String   // CUSTOMER | ADMIN | DRIVER | SYSTEM
  actorId    String?  // driver.id oder company.id, je nach actorType
  reason     String?
  createdAt  DateTime @default(now())

  @@index([bookingId])
}
